    "title": "Tasks vs Results",
    "slug": "task-results",
    "chapterNumber": "CHAPTER ∙ 02",
    "colorStrong": "#f57431",
    "colorLight": "#fde3d5",
    "purpose": "Going way further dodging unnecessary tasks",
    "body": [
      {
        "primary": {
          "id": "audio-tasks",
          "caption": "CHAPTER PREVIEW",
          "audio": {
            "link_type": "Media",
            "name": "avulsos_01_task_results.mp3",
